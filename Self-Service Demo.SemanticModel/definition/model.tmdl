model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup CSV

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Source","Customer","Date","Product","Sales","Store","Currency Exchange","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Source
ref table Customer
ref table Date
ref table Product
ref table Sales
ref table Store
ref table 'Currency Exchange'
ref table _Measures

ref cultureInfo en-US

