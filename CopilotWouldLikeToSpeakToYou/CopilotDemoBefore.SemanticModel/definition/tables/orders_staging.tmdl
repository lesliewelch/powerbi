		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition orders_staging = m
		mode: import
		source =
				let
				    Source = Sql.Database("sql-datacopilotdemo-lw.database.windows.net", "datacopilotdemo"),
				    dbo_orders = Source{[Schema="dbo",Item="orders"]}[Data]
				in
				   dbo_orders

	annotation PBI_ResultType = Table

