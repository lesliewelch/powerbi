table orders_staging
	lineageTag: f9aa8a40-a90c-4cd5-af53-1a2abff445b7

	measure 'Total Orders' = COUNTROWS ( orders_staging )
		lineageTag: f7a8b454-4912-4d08-ae3e-7fd73ec8e679

	measure 'Orders Delivered' = CALCULATE ( COUNTROWS ( orders_staging ), orders_staging[order_status] = 4 )
		lineageTag: adf1fb2b-9b4a-4a9b-a24d-aa57c0d58ee5

	measure 'Avg Delivery Days' = AVERAGE ( orders_staging[Delivery Days] )
		lineageTag: fcd928ea-61d1-4555-a179-1f407872a6b6

	measure 'On Time Orders' =
			CALCULATE (
				COUNTROWS ( orders_staging ),
				FILTER (
					orders_staging,
					NOT ISBLANK ( orders_staging[order_delivered_customer_date] )
						&& orders_staging[order_delivered_customer_date] <= orders_staging[order_estimated_delivery_date]
				)
			)
		lineageTag: 690eb36a-e129-4f03-856e-8280c14b0efb

	measure 'On Time Rate' = IF ( [Total Orders] = 0, BLANK ( ), [On Time Orders] / [Total Orders] )
		lineageTag: 42387240-ecc8-4aca-a3d8-16350fbed94f

	measure 'Not Delivered or Late %' = IF ( [Total Orders] = 0, BLANK ( ), ( [Total Orders] - [On Time Orders] ) / [Total Orders] )
		lineageTag: 7a1c2db2-88ae-42ff-86f2-6395b2fc8280

	measure 'Late Order %' = IF ( [Total Orders] = 0, BLANK ( ), DIVIDE ( [Total Orders] - [On Time Orders], [Total Orders] ) )
		lineageTag: 9e2771c3-1548-4501-a8b6-1b1003b67a20

	measure 'Avg Days To Ship' = AVERAGE ( orders_staging[Ship Days] )
		lineageTag: 22737d4a-4fcd-4feb-94a1-af7b0cc6f0aa

	measure 'Avg Purchase to Approved' = AVERAGE ( orders_staging[Approve Days] )
		lineageTag: e53a6667-230c-4d65-9d51-714f57fdce85

	measure 'Avg Approved to Carrier' = AVERAGE ( orders_staging[Carrier Days] )
		lineageTag: 200b91b8-9530-42a4-b324-3a8d8b53f294

	measure 'Avg Carrier to Delivered' = AVERAGE ( orders_staging[Delivery Days] ) - AVERAGE ( orders_staging[Carrier Days] )
		lineageTag: 25770e8f-05fa-46e2-9a4a-123af0d359de

	measure Cartesian =
			
			COUNTROWS (
			    FILTER (
			        CROSSJOIN ( VALUES ( orders_staging[order_id] ), VALUES ( sellers[seller_id] ) ),
			        1 = 1
			    )
			)
		formatString: 0
		lineageTag: f3c44c33-4097-494d-9806-0026d061054a

	measure 'Median Delivery Days' = MEDIANX ( orders_staging, orders_staging[Delivery Days] )
		lineageTag: 6f07b7d5-2eac-486d-b0c2-bfba8ba70a11

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders Beatable by Other Sellers' =
			
			COUNTROWS (
			    FILTER (
			        CROSSJOIN (
			            SUMMARIZE (
			                orders_staging,
			                orders_staging[order_id],
			                "OrderDelivery", CALCULATE ( AVERAGE ( orders_staging[Delivery Days] ) )
			            ),
			            VALUES ( sellers[seller_id] )
			        ),
			        [OrderDelivery] > CALCULATE ( AVERAGE ( orders_staging[Delivery Days] ) )
			    )
			)
		formatString: 0
		lineageTag: 82e09925-bcda-45d7-b3f7-bb0263c8957e

	measure 'High Freight Orders' = ```
			
			CALCULATE ( COUNTROWS ( order_items ), FILTER ( order_items, order_items[freight_value] > 50 ) )
			
			```
		formatString: 0
		lineageTag: e7fa9ded-412d-461a-aa38-6ca28a754b3a

	measure 'Seller Order Count' = COUNTROWS ( orders_staging )
		formatString: 0
		lineageTag: 34359673-dec0-4e7d-a304-2d30cd68cdde

	measure 'Avg Sourcing Options per Order' = DIVIDE ( [Sourcing Options], DISTINCTCOUNT ( orders_staging[order_id] ) )
		lineageTag: dcb6940d-5660-4b77-9c29-36b020410daa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

