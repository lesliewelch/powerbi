	column 'Order Year' = YEAR ( orders_staging[order_purchase_timestamp] )
		dataType: int64
		lineageTag: c37cd582-f681-492f-a7b7-25dce28b31d1
		summarizeBy: sum

	column 'Order Month' = FORMAT ( orders_staging[order_purchase_timestamp], "mmm" )
		dataType: string
		lineageTag: 497e001b-20c6-4b21-b8c4-e828b1a74325
		summarizeBy: none

	column 'Delivery Days' =
			IF (
				NOT ISBLANK ( orders_staging[order_delivered_customer_date] ),
				DATEDIFF ( orders_staging[order_purchase_timestamp], orders_staging[order_delivered_customer_date], DAY )
			)
		dataType: int64
		lineageTag: 57ebbf9e-9bab-4e9f-b95f-b54aab443709
		summarizeBy: sum

	column 'Ship Days' =
			IF (
				NOT ISBLANK ( orders_staging[order_delivered_carrier_date] ),
				DATEDIFF ( orders_staging[order_purchase_timestamp], orders_staging[order_delivered_carrier_date], DAY )
			)
		dataType: int64
		lineageTag: ec2143a5-8de1-45b9-b388-7fda9698fd50
		summarizeBy: sum

	column 'Approve Days' =
			IF (
				NOT ISBLANK ( orders_staging[order_approved_at] ),
				DATEDIFF ( orders_staging[order_purchase_timestamp], orders_staging[order_approved_at], DAY )
			)
		dataType: int64
		lineageTag: 6651ddf4-e775-4478-b67d-109495ee5716
		summarizeBy: sum

	column 'Carrier Days' =
			IF (
				NOT ISBLANK ( orders_staging[order_delivered_carrier_date] ),
				DATEDIFF ( orders_staging[order_approved_at], orders_staging[order_delivered_carrier_date], DAY )
			)
		dataType: int64
		lineageTag: adf948ba-7a1f-40e8-a500-b3fed6b804c6
		summarizeBy: sum

	column 'Lateness Bucket' =
			IF ( orders_staging[Delivery Days] <= 5, "0-5 days",
				IF ( orders_staging[Delivery Days] <= 10, "6-10 days",
					IF ( orders_staging[Delivery Days] <= 20, "11-20 days", "20+ days" ) ) )
		dataType: string
		lineageTag: cc460039-722a-4c12-84be-89c1cd26c9bb
		summarizeBy: none

	column order_weight_kg
		dataType: double
		lineageTag: 641b8e3b-5c15-438d-8b08-2c352fa4bd25
		summarizeBy: sum
		sourceColumn: order_weight_kg

