table geolocation
	lineageTag: 2f04371d-33b5-4fef-a0e2-04c02efe220c

	measure 'Geo Points In Scope' =
			
			CALCULATE (
			    COUNTROWS ( geolocation ),
			    TREATAS (
			        VALUES ( customers[customer_zip_code_prefix] ),
			        geolocation[geolocation_zip_code_prefix]
			    )
			)
		formatString: 0
		lineageTag: 40b87d16-99f5-4511-91f0-a8e5f78952f9

	column geolocation_zip_code_prefix
		dataType: string
		lineageTag: 7fdd5928-38a7-4bc2-9d68-ca4408874bd0
		summarizeBy: none
		sourceColumn: geolocation_zip_code_prefix

		annotation SummarizationSetBy = Automatic

	column geolocation_lat
		dataType: double
		lineageTag: 72c449ac-1a98-46a3-8d60-f795fdd2b5a5
		summarizeBy: sum
		sourceColumn: geolocation_lat

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column geolocation_lng
		dataType: double
		lineageTag: 6f35d494-f028-40b2-b144-d9ba80b5de03
		summarizeBy: sum
		sourceColumn: geolocation_lng

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column geolocation_city
		dataType: string
		lineageTag: 680b1e55-2c9a-4875-aaf8-f9f45e2f3d35
		summarizeBy: none
		sourceColumn: geolocation_city

		annotation SummarizationSetBy = Automatic

	column geolocation_state
		dataType: string
		lineageTag: ab1082f5-7af1-4c7a-b323-2358543189c2
		summarizeBy: none
		sourceColumn: geolocation_state

		annotation SummarizationSetBy = Automatic

	partition geolocation = m
		mode: import
		source =
				let
				    Source = Sql.Database("sql-datacopilotdemo-lw.database.windows.net", "datacopilotdemo"),
				    dbo_geolocation = Source{[Schema="dbo",Item="geolocation"]}[Data]
				in
				    dbo_geolocation

	annotation PBI_ResultType = Table

