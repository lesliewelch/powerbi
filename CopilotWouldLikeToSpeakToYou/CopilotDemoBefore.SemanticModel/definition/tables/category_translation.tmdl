table category_translation
	lineageTag: d4b15952-cf2e-4760-8d27-02693e6a9566

	measure 'Avg Seller Delivery Percentile' =
			
			AVERAGEX (
			    VALUES ( sellers[seller_id] ),
			    VAR SellerAvg = CALCULATE ( AVERAGE ( orders_staging[Delivery Days] ) )
			    VAR FasterOrders =
			        CALCULATE (
			            COUNTROWS ( orders_staging ),
			            FILTER ( ALL ( orders_staging ), orders_staging[Delivery Days] <= SellerAvg )
			        )
			    RETURN DIVIDE ( FasterOrders, CALCULATE ( COUNTROWS ( orders_staging ), ALL ( orders_staging ) ) )
			)
		lineageTag: 74b6fcbf-0e6a-4d68-be26-11bf50484a61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column product_category_name
		dataType: string
		lineageTag: 69f279a9-be25-498c-9e9f-ab0bb48fda7b
		summarizeBy: none
		sourceColumn: product_category_name

		annotation SummarizationSetBy = Automatic

	column product_category_name_english
		dataType: string
		lineageTag: c3b33cf2-7003-4002-984e-d0123f18f59f
		summarizeBy: none
		sourceColumn: product_category_name_english

		annotation SummarizationSetBy = Automatic

	partition category_translation = m
		mode: import
		source =
				let
				    Source = Sql.Database("sql-datacopilotdemo-lw.database.windows.net", "datacopilotdemo"),
				    dbo_category_translation = Source{[Schema="dbo",Item="category_translation"]}[Data]
				in
				    dbo_category_translation

	annotation PBI_ResultType = Table

